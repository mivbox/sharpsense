{
  "name": "sharpsense",
  "version": "1.3.1",
  "description": "Find implementations from behavior, explore code relationships, assess change impact, maintain code memories, and summarize noisy command output with SharpSense.",
  "author": {
    "name": "Mitchel Box"
  },
  "homepage": "https://github.com/mivbox/sharpsense",
  "repository": "https://github.com/mivbox/sharpsense",
  "license": "MIT",
  "keywords": [
    "sharpsense",
    "code-analysis",
    "skills"
  ],
  "skills": [
    "./skills/"
  ],
  "mcpServers": {
    "sharpsense": {
      "type": "stdio",
      "command": "sharpsense",
      "args": [
        "mcp",
        "--workspace-root",
        "${CLAUDE_PROJECT_DIR}"
      ]
    }
  }
}
