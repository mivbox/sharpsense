<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <FrontendProjectDir>../SharpSense.UI</FrontendProjectDir>
    <TargetFramework>$(NetCoreAppVersion)</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- No-build packaging reuses the manifest already embedded in the assembly. -->
    <GenerateEmbeddedFilesManifest Condition="'$(NoBuild)' != 'true'">true</GenerateEmbeddedFilesManifest>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sharpsense</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>SharpSense.Cli</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>1.0.0</Version>
    <Authors>Mitchel Box</Authors>
    <Description>Polyglot knowledge graph indexer and AI architecture tool.</Description>
    <PackageProjectUrl>https://github.com/mivbox/sharpsense</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mivbox/sharpsense</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\"/>
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpSense.Application\SharpSense.Application.csproj"/>
    <ProjectReference Include="..\SharpSense.Infrastructure\SharpSense.Infrastructure.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations"/>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
    <!-- Load MSBuild dependencies from the SDK selected by Microsoft.Build.Locator. -->
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.OpenApi"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded"/>
    <PackageReference Include="ModelContextProtocol"/>
    <PackageReference Include="Serilog"/>
    <PackageReference Include="Serilog.AspNetCore"/>
    <PackageReference Include="Serilog.Sinks.File"/>
    <PackageReference Include="Spectre.Console.Cli"/>
    <PackageReference Include="Spectre.Console"/>
  </ItemGroup>

  <Target Name="BuildFrontend" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(FrontendBuildCompleted)' != 'true'">
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(FrontendProjectDir)"/>
    <Exec Command="pnpm run build" WorkingDirectory="$(FrontendProjectDir)"/>
    <PropertyGroup>
      <FrontendBuildCompleted>true</FrontendBuildCompleted>
    </PropertyGroup>
  </Target>

  <Target Name="EmbedFrontend" BeforeTargets="BeforeBuild" DependsOnTargets="BuildFrontend" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <FrontendDistFile Include="$(FrontendProjectDir)/dist/**/*.*"/>
      <FrontendDistFile Update="@(FrontendDistFile)">
        <TargetPath>SharpSense.UI/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      </FrontendDistFile>
      <EmbeddedResource Include="@(FrontendDistFile)"/>
    </ItemGroup>
  </Target>

  <Target Name="PreventExoticRuntimesFromPublishing" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('android'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('ios'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('maccatalyst'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('browser'))" />

      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('linux-mips'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('linux-musl'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('linux-ppc'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('linux-riscv'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('linux-s390'))" />

      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'win-x86'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'win-arm'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'linux-x86'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'linux-arm'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'linux-armel'" />
    </ItemGroup>
  </Target>

  <!-- The BERT embedder uses base ONNX Runtime. GenAI serves an unused chat connector.
       TypeScript/TSX need only their two grammars and the Tree-sitter core library. -->
  <Target Name="TrimUnusedNativeAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
          Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'TreeSitter.DotNet' and !$([System.Text.RegularExpressions.Regex]::IsMatch('%(RuntimeTargetsCopyLocalItems.Filename)', '^(lib)?tree-sitter(-typescript|-tsx)?$'))" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
          Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'TreeSitter.DotNet' and !$([System.Text.RegularExpressions.Regex]::IsMatch('%(NativeCopyLocalItems.Filename)', '^(lib)?tree-sitter(-typescript|-tsx)?$'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
          Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'Microsoft.ML.OnnxRuntimeGenAI'" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
          Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'Microsoft.ML.OnnxRuntimeGenAI'" />
    </ItemGroup>
  </Target>

</Project>
